---
import "@fontsource-variable/intel-one-mono";
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/instrument-sans";
import "../styles/global.css";

interface Props {
  title: string;
  current: "preview" | "record" | "research" | "users" | "device";
}

const { title, current } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="mark" href="/" aria-label="Face-ID home"><svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M11 4H7a3 3 0 0 0-3 3v4m17-7h4a3 3 0 0 1 3 3v4M4 21v4a3 3 0 0 0 3 3h4m10 0h4a3 3 0 0 0 3-3v-4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><path d="M11 12v3m10-3v3m-9 6c2.5 2 5.5 2 8 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg><span>Face<span class="mark-light">ID</span><small>ACCESS CONSOLE</small></span></a>
      <nav aria-label="Main navigation">
        <a href="/" aria-current={current === "preview" ? "page" : undefined}>Preview</a>
        <a href="/record" aria-current={current === "record" ? "page" : undefined}>Record</a>
        <a href="/users" aria-current={current === "users" ? "page" : undefined}>People</a>
        <a href="/device" aria-current={current === "device" ? "page" : undefined}>Device</a>
      </nav>
      <span class="header-label"><span class="lock-icon" aria-hidden="true">◇</span> Development mode</span>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer"><span>Face-ID <span class="footer-divider">/</span> Intel RealSense D435</span><span>IR + depth sensing <span class="footer-divider">·</span> Local processing <span class="footer-divider">·</span> <a href="/record-research" aria-current={current === "research" ? "page" : undefined}>Research tools</a></span></footer>
  </body>
</html>
