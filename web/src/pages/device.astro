---
import Base from "../layouts/Base.astro";
---

<Base title="Device — Face-ID" current="device">
  <div class="stack">
    <h1 id="title">On the bus</h1>
    <p id="status" class="note"></p>
    <dl id="info"></dl>
  </div>
</Base>

<script>
  const title = document.querySelector("#title");
  const status = document.querySelector("#status");
  const info = document.querySelector("#info");

  function row(label: string, value: string): void {
    if (!info) return;
    const term = document.createElement("dt");
    term.textContent = label;
    const data = document.createElement("dd");
    data.textContent = value;
    info.append(term, data);
  }

  const response = await fetch("/v1/device/info");
  const body = await response.json();
  if (!response.ok) {
    if (title) title.textContent = "No camera on the bus";
    if (status) {
      const detail = String(body.detail ?? "The camera is not connected.");
      status.textContent = detail.charAt(0).toUpperCase() + detail.slice(1);
      status.className = "note bad";
    }
  } else if (title && info) {
    title.textContent = body.name;
    if (status) status.textContent = "";
    row("Serial", body.serial);
    row("Firmware", body.firmware);
    if (body.product_line) row("Product", body.product_line);
  }
</script>
