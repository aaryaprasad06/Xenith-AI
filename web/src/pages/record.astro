---
import Button from "../components/Button.astro";
import Base from "../layouts/Base.astro";
---

<Base title="Record — Face-ID" current="record">
  <header class="page-heading">
    <p class="eyebrow">01 / FACE CAPTURE</p>
    <h1>Record your face</h1>
    <p>Follow the circle to record your face, then enroll the saved samples for face access.</p>
  </header>
  <div class="recorder">
    <div class="panel">
      <h2 class="section-heading">Capture setup</h2>
      <p class="panel-intro">Choose a person and session before recording.</p>
      <div class="token">
        <label for="token">Admin token</label>
        <input id="token" type="password" placeholder="Paste admin token" autocomplete="current-password" />
        <Button id="save-token" variant="quiet" type="button">Save token</Button>
      </div>
      <form id="labels" class="fields">
        <label>Person <input id="person" type="text" required maxlength="64" placeholder="p001" autocomplete="off" /></label>
        <label>Session <input id="session" type="text" required maxlength="64" placeholder="s1" autocomplete="off" /></label>
        <label class="check"><input id="glasses" type="checkbox" /> Wearing glasses</label>
        <label class="check"><input id="overwrite" type="checkbox" /> Replace takes already recorded</label>
        <label class="check"><input id="consent" type="checkbox" /> This person's consent is on file</label>
      </form>
      <p id="message" class="result" role="status"></p>

      <h2 class="section-heading">Finish enrollment</h2>
      <p>After recording, enroll this person's saved session to add them to People and enable face access.</p>
      <Button id="enroll-face" type="button" disabled>Enroll face from this session</Button>
      <p><a href="/users">View People and face access</a></p>

      <h2 class="section-heading">Recorded in this session</h2>
      <p id="empty-takes" class="empty-takes">No takes yet. Completed samples will appear here.</p>
      <ul id="takes" class="people"></ul>

    </div>

    <section class="stage">
      <div class="capture-meta"><span class="eyebrow">Guided capture</span><span>Colour preview</span></div>
      <div class="ring" id="ring" data-state="idle">
        <img class="face-view" src="/v1/preview/rgb" alt="Live colour view from the RealSense camera, mirrored" />
        <div class="face-placeholder" aria-hidden="true">
          <svg viewBox="0 0 32 32"><path d="M5 9h5l2-3h8l2 3h5a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V11a2 2 0 0 1 2-2Z"/><circle cx="16" cy="17" r="5"/></svg>
          <span>Waiting for camera</span>
        </div>
        <svg viewBox="-100 -100 200 200" aria-hidden="true">
          <g id="ticks"></g>
          <circle id="pointer" class="pointer" r="5" cx="0" cy="0"></circle>
        </svg>
      </div>
      <p class="camera-caption">Colour camera <span>•</span> Keep your face centered</p>
      <p id="prompt" class="prompt" role="status">Press Start and follow the circle.</p>
      <p id="rate" class="rate"></p>
      <div class="actions">
        <Button id="start" type="button">Start</Button>
        <Button id="cancel" variant="quiet" type="button">Cancel</Button>
      </div>
      <ol id="steps" class="steps"></ol>
    </section>
  </div>
</Base>

<script>
  import { authHeaders, readToken, saveToken } from "../lib/admin";
  import { buttonClass } from "../lib/button";

  const $ = <T extends HTMLElement>(id: string) => document.querySelector<T>(`#${id}`)!;
  const tokenInput = $<HTMLInputElement>("token");
  const person = $<HTMLInputElement>("person");
  const session = $<HTMLInputElement>("session");
  const glasses = $<HTMLInputElement>("glasses");
  const overwrite = $<HTMLInputElement>("overwrite");
  const consent = $<HTMLInputElement>("consent");
  const message = $("message");
  const prompt = $("prompt");
  const ticksGroup = $("ticks");
  const stepsList = $("steps");
  const takesList = $("takes");
  const startButton = $<HTMLButtonElement>("start");
  const cancelButton = $<HTMLButtonElement>("cancel");
  const enrollButton = $<HTMLButtonElement>("enroll-face");
  const ring = $("ring");
  const rate = $("rate");
  const emptyTakes = $("empty-takes");
  const preview = document.querySelector<HTMLImageElement>(".face-view")!;
  const placeholder = document.querySelector<HTMLElement>(".face-placeholder")!;
  const pointer = document.querySelector<SVGCircleElement>("#pointer")!;

  type Step = "circle";

  interface Take {
    take: string;
    frames: number;
    laser_on: number;
    laser_off: number;
    attack: string;
  }

  interface GuidedState {
    status: "idle" | "running" | "saving" | "done" | "failed" | "cancelled";
    step: Step | null;
    phase: string | null;
    prompt: string;
    progress: number;
    ticks: boolean[];
    counts: Record<string, number>;
    saved: string[];
    pairs_per_s: number;
    pointer: [number, number] | null;
  }

  const STEPS: Array<{ step: Step; title: string; how: string }> = [
    { step: "circle", title: "Face circle", how: "Look straight at the camera, then roll your head slowly in a circle." },
  ];
  const TICKS = 48;

  let selected: Step = "circle";
  let recorded: Take[] = [];
  let polling: number | undefined;
  let active = false;
  let guidedActive = false;
  let statusReady = false;
  startButton.disabled = true;

  let previewRetry: number | undefined;
  preview.addEventListener("load", () => {
    placeholder.hidden = true;
    window.clearTimeout(previewRetry);
  });
  preview.addEventListener("error", () => {
    placeholder.hidden = false;
    window.clearTimeout(previewRetry);
    previewRetry = window.setTimeout(() => { preview.src = `/v1/preview/rgb?t=${Date.now()}`; }, 2000);
  });
  if (preview.complete && preview.naturalWidth > 0) placeholder.hidden = true;

  tokenInput.value = readToken();
  try {
    person.value = localStorage.getItem("face-id-record-person") ?? "";
    session.value = localStorage.getItem("face-id-record-session") ?? "";
  } catch {
    // Storage can be blocked; the fields just start empty.
  }

  function show(text: string, tone: "good" | "bad" | "" = ""): void {
    const trimmed = text.trim();
    message.textContent = trimmed ? trimmed.charAt(0).toUpperCase() + trimmed.slice(1) : trimmed;
    message.className = tone ? `result ${tone}` : "result";
  }

  // Ticks are counter-clockwise from screen right, matching the API's `ticks`.
  const tickLines: SVGLineElement[] = [];
  for (let i = 0; i < TICKS; i += 1) {
    const angle = ((i + 0.5) * 2 * Math.PI) / TICKS;
    const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
    line.setAttribute("x1", String(91 * Math.cos(angle)));
    line.setAttribute("y1", String(-91 * Math.sin(angle)));
    line.setAttribute("x2", String(96 * Math.cos(angle)));
    line.setAttribute("y2", String(-96 * Math.sin(angle)));
    ticksGroup.append(line);
    tickLines.push(line);
  }

  function paintTicks(lit: boolean[]): void {
    tickLines.forEach((line, i) => line.classList.toggle("on", Boolean(lit[i])));
  }

  // Outside the circle phase, fill clockwise from the top as progress grows.
  function progressTicks(progress: number): boolean[] {
    return tickLines.map((_, i) => {
      const angle = ((i + 0.5) * 2 * Math.PI) / TICKS;
      const clockwiseFromTop = (((Math.PI / 2 - angle) % (2 * Math.PI)) + 2 * Math.PI) % (2 * Math.PI);
      return clockwiseFromTop / (2 * Math.PI) < progress;
    });
  }

  function stepTakes(_step: Step): string[] {
    const g = glasses.checked ? "_glasses" : "";
    const poses = ["center", "right", "up_right", "up", "up_left", "left", "down_left", "down", "down_right"];
    return poses.map(pose => `${pose}_lit${g}`);
  }

  function renderSteps(): void {
    const done = new Set(recorded.map((take) => take.take));
    const restoreFocus = document.activeElement instanceof HTMLButtonElement && document.activeElement.closest("#steps") !== null;
    stepsList.replaceChildren(
      ...STEPS.map(({ step, title, how }) => {
        const item = document.createElement("li");
        const button = document.createElement("button");
        button.type = "button";
        button.dataset.step = step;
        button.setAttribute("aria-pressed", String(step === selected));
        button.disabled = active;
        const finished = stepTakes(step).every((name) => done.has(name));
        button.className = `step${step === selected ? " selected" : ""}${finished ? " done" : ""}`;
        const head = document.createElement("span");
        head.className = "step-title";
        head.textContent = `${finished ? "✓" : "○"} ${title}`;
        const body = document.createElement("span");
        body.className = "step-how";
        body.textContent = how;
        button.append(head, body);
        button.addEventListener("click", () => {
          selected = step;
          renderSteps();
          paintTicks([]);
          ring.dataset.state = "idle";
          pointer.classList.remove("shown");
          prompt.className = "prompt";
          rate.textContent = "";
          prompt.textContent = `${title}. ${how} Press Start.`;
        });
        item.append(button);
        return item;
      }),
    );
    if (restoreFocus) stepsList.querySelector<HTMLButtonElement>(`[data-step="${selected}"]`)?.focus();
  }

  function renderTakes(): void {
    emptyTakes.hidden = recorded.length > 0;
    takesList.replaceChildren(
      ...recorded.map((take) => {
        const item = document.createElement("li");
        const name = document.createElement("span");
        name.className = "person";
        name.textContent = take.take;
        const detail = document.createElement("span");
        detail.className = "when";
        detail.textContent = `${take.frames} frames, ${take.laser_on} laser-on, ${take.laser_off} laser-off`;
        name.append(detail);
        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = buttonClass("danger");
        remove.textContent = "Delete";
        remove.addEventListener("click", async () => {
          if (active) return;
          const path = [person.value.trim(), session.value.trim(), take.take].map(encodeURIComponent).join("/");
          const response = await fetch(`/v1/recordings/${path}`, { method: "DELETE", headers: authHeaders() });
          const body = await response.json();
          show(response.ok ? `Deleted ${take.take}.` : (body.detail ?? "Delete failed"), response.ok ? "" : "bad");
          await refresh();
        });
        item.append(name, remove);
        return item;
      }),
    );
  }

  async function refresh(): Promise<void> {
    const p = person.value.trim();
    const s = session.value.trim();
    recorded = [];
    if (p && s) {
      const query = new URLSearchParams({ person: p, session: s });
      const response = await fetch(`/v1/recordings?${query}`, { headers: authHeaders() });
      const body = await response.json();
      if (response.ok) recorded = body.takes.filter((take: Take) => take.attack === "none");
      else show(body.detail ?? "Could not list takes", "bad");
    }
    renderSteps();
    renderTakes();
    enrollButton.disabled = active || recorded.length === 0;
  }

  function ready(): boolean {
    if (!person.value.trim() || !session.value.trim()) {
      show("Set the person and the session first.", "bad");
      return false;
    }
    if (!consent.checked) {
      show("Tick the consent box. Record only people whose consent is on file.", "bad");
      return false;
    }
    return true;
  }

  function setRunning(running: boolean, guided = false): void {
    active = running;
    guidedActive = running && guided;
    startButton.disabled = running || !statusReady;
    cancelButton.disabled = !guidedActive;
    enrollButton.disabled = running || recorded.length === 0;
    [person, session, glasses, overwrite, consent].forEach((control) => { control.disabled = running; });
    document.querySelectorAll<HTMLButtonElement>("#steps button, #takes button").forEach((button) => { button.disabled = running; });
    ring.classList.toggle("live", running);
  }

  function nextStep(): void {
    const done = new Set(recorded.map((take) => take.take));
    const next = STEPS.find(({ step }) => !stepTakes(step).every((name) => done.has(name)));
    if (next) {
      selected = next.step;
      renderSteps();
    }
  }

  function apply(state: GuidedState): void {
    ring.dataset.state = state.status;
    prompt.className = state.status === "failed" ? "prompt bad" : state.status === "done" ? "prompt good" : "prompt";
    if (state.status === "idle") {
      prompt.textContent = "Press Start and follow the circle.";
      pointer.classList.remove("shown");
      rate.textContent = "";
      return;
    }
    prompt.textContent = state.status === "done" ? "Recordings saved. Enroll your face to finish." : state.prompt;
    paintTicks(state.phase === "circle" || state.status === "done" ? state.ticks : progressTicks(state.progress));
    // The dot shows where the head points; reaching the ticks (radius 84) counts.
    const showPointer = state.status === "running" && state.phase === "circle" && state.pointer !== null;
    pointer.classList.toggle("shown", showPointer);
    if (showPointer && state.pointer) {
      const [px, py] = state.pointer;
      const length = Math.hypot(px, py);
      const clamp = length > 1.15 ? 1.15 / length : 1;
      pointer.setAttribute("cx", String(px * clamp * 84));
      pointer.setAttribute("cy", String(-py * clamp * 84));
    }
    rate.textContent =
      state.status === "running" ? `${state.pairs_per_s.toFixed(1)} frame pairs/s checked` : "";
  }

  async function poll(): Promise<void> {
    try {
      const response = await fetch("/v1/recordings/guided", { headers: authHeaders() });
      if (!response.ok) throw new Error("status request failed");
      const state: GuidedState = await response.json();
      statusReady = true;
      apply(state);
      if (state.status === "running" || state.status === "saving") {
        setRunning(true, true);
        polling = window.setTimeout(() => void poll(), 150);
        return;
      }
      polling = undefined;
      setRunning(false);
      if (state.status === "done") {
        show(`Saved ${state.saved.length} takes. Click "Enroll face from this session" to finish adding this person.`, "good");
        overwrite.checked = false;
        await refresh().catch(() => show("Saved successfully, but the take list could not refresh.", "bad"));
        nextStep();
      } else if (state.status === "failed") {
        show(state.prompt || "Capture failed. Check the setup and try again.", "bad");
      } else if (state.status === "cancelled") {
        show("Capture cancelled. You can try again when ready.");
      }
    } catch {
      if (guidedActive) {
        prompt.textContent = "Connection lost. Capture may still be running; reconnecting to its status…";
        show("Capture status is temporarily unavailable. The subject stays locked while reconnecting.", "bad");
        polling = window.setTimeout(() => void poll(), 1000);
      } else {
        statusReady = false;
        polling = undefined;
        setRunning(false);
        ring.dataset.state = "failed";
        prompt.textContent = "Could not check the capture service.";
        show("Could not check capture status. Save your admin token to retry when the API is available.", "bad");
      }
    }
  }

  async function start(): Promise<void> {
    if (!statusReady || startButton.disabled || !ready()) return;
    setRunning(true);
    ring.dataset.state = "running";
    prompt.className = "prompt";
    show("");
    try {
    const response = await fetch("/v1/recordings/guided", {
      method: "POST",
      headers: { ...authHeaders(), "Content-Type": "application/json" },
      body: JSON.stringify({
        person: person.value.trim(),
        session: session.value.trim(),
        step: selected,
        glasses: glasses.checked,
        consent: consent.checked,
        overwrite: overwrite.checked,
      }),
    });
    const body = await response.json();
    if (!response.ok) {
      setRunning(false);
      ring.dataset.state = "failed";
      const detail = typeof body.detail === "string" ? body.detail : "Could not start";
      prompt.textContent = detail;
      prompt.className = "prompt bad";
      show(response.status === 409 ? `${detail}. Tick "Replace" to record them again.` : detail, "bad");
      return;
    }
    apply(body);
    if (window.matchMedia("(width < 768px)").matches) {
      ring.scrollIntoView({ behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth", block: "start" });
    }
    if (body.status === "running" || body.status === "saving") setRunning(true, true);
    else setRunning(false);
    if (polling === undefined) void poll();
    } catch {
      setRunning(false);
      ring.dataset.state = "failed";
      prompt.textContent = "Could not start capture.";
      prompt.className = "prompt bad";
      show("The API could not start capture. Check the connection and try again.", "bad");
    }
  }

  async function cancel(): Promise<void> {
    if (!guidedActive) return;
    cancelButton.disabled = true;
    try {
      const response = await fetch("/v1/recordings/guided", { method: "DELETE", headers: authHeaders() });
      if (!response.ok) throw new Error("cancel request failed");
      prompt.textContent = "Cancelling capture…";
      if (polling === undefined) void poll();
    } catch {
      cancelButton.disabled = false;
      show("Could not cancel capture. Try again while the API is available.", "bad");
    }
  }

  function remember(): void {
    try {
      localStorage.setItem("face-id-record-person", person.value.trim());
      localStorage.setItem("face-id-record-session", session.value.trim());
    } catch {
      // Not remembering the labels is fine.
    }
    refresh().catch(() => show("The API is unreachable.", "bad"));
  }

  async function enrollFace(): Promise<void> {
    if (active || !ready()) return;
    const userId = person.value.trim();
    setRunning(true);
    enrollButton.textContent = "Enrolling face…";
    show("Preparing face samples. This may take a few seconds.");
    try {
      const response = await fetch(`/v1/users/${encodeURIComponent(userId)}/enroll-takes`, {
        method: "POST",
        headers: { ...authHeaders(), "Content-Type": "application/json" },
        body: JSON.stringify({ session: session.value.trim(), consent: consent.checked }),
      });
      const body = await response.json();
      if (!response.ok) throw new Error(typeof body.detail === "string" ? body.detail : "Could not enroll face.");
      show(`${userId} enrolled from ${body.takes_used} takes. They now appear in People with face access.`, "good");
      prompt.textContent = "Face enrolled. Ready to authenticate.";
    } catch (error) {
      show(error instanceof Error ? error.message : "Enrollment failed. Your recordings are saved; try again.", "bad");
    } finally {
      enrollButton.textContent = "Enroll face from this session";
      setRunning(false);
    }
  }

  person.addEventListener("change", () => {
    consent.checked = false;
    remember();
  });
  session.addEventListener("change", remember);
  glasses.addEventListener("change", renderSteps);
  startButton.addEventListener("click", () => void start());
  cancelButton.addEventListener("click", () => void cancel());
  enrollButton.addEventListener("click", () => void enrollFace());
  $("labels").addEventListener("submit", (event) => event.preventDefault());

  document.addEventListener("keydown", (event) => {
    const target = event.target as HTMLElement | null;
    if (event.code === "Space" && !target?.closest("input, select, textarea, button, summary")) {
      event.preventDefault();
      void start();
    }
  });

  $("save-token").addEventListener("click", () => {
    saveToken(tokenInput.value);
    if (polling === undefined && !active) void poll();
    Promise.all([refresh()]).catch(() => show("The API is unreachable.", "bad"));
  });

  paintTicks([]);
  Promise.all([refresh(), poll()]).catch(() => show("The API is unreachable.", "bad"));
</script>
