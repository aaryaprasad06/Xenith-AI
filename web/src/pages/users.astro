---
import Button from "../components/Button.astro";
import Base from "../layouts/Base.astro";
---

<Base title="People — Face-ID" current="users">
  <div class="stack">
    <h1>Enrol a person</h1>
    <p class="note">Only an id is stored. Matching comes later, so the door stays locked.</p>
    <div class="token">
      <input id="token" type="password" placeholder="Admin token" autocomplete="current-password" />
      <Button id="save-token" variant="quiet" type="button">Save token</Button>
    </div>
    <form id="enroll" class="enroll">
      <input id="user-id" type="text" placeholder="Name or id" required maxlength="100" autocomplete="off" />
      <Button type="submit">Enrol</Button>
    </form>
    <p id="message" class="result" role="status"></p>
    <ul id="people" class="people"></ul>
  </div>
</Base>

<script>
  import { authHeaders, readToken, saveToken } from "../lib/admin";
  import { buttonClass } from "../lib/button";

  const tokenInput = document.querySelector<HTMLInputElement>("#token");
  const message = document.querySelector("#message");
  const list = document.querySelector("#people");
  const form = document.querySelector<HTMLFormElement>("#enroll");
  const userId = document.querySelector<HTMLInputElement>("#user-id");

  if (tokenInput) tokenInput.value = readToken();

  function show(text: string, ok = false): void {
    if (!message) return;
    const trimmed = text.trim();
    message.textContent = trimmed ? trimmed.charAt(0).toUpperCase() + trimmed.slice(1) : trimmed;
    message.className = ok ? "result" : "result bad";
  }

  function when(iso: string): string {
    const date = new Date(iso);
    if (Number.isNaN(date.getTime())) return iso;
    return date.toLocaleString(undefined, {
      year: "numeric",
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  async function refresh(preserveMessage = false): Promise<void> {
    const response = await fetch("/v1/users", { headers: authHeaders() });
    const body = await response.json();
    if (!response.ok) {
      if (!preserveMessage) show(body.detail ?? "Could not list people");
      if (list) list.replaceChildren();
      return;
    }
    if (!preserveMessage && message) {
      if (body.users.length === 0) show("No one is enrolled yet.", true);
      else {
        message.textContent = "";
        message.className = "result";
      }
    }
    if (!list) return;
    list.replaceChildren();
    for (const person of body.users) {
      const item = document.createElement("li");
      const name = document.createElement("span");
      name.className = "person";
      name.textContent = person.user_id;
      const time = document.createElement("span");
      time.className = "when";
      time.textContent = when(person.created_at);
      name.append(time);
      const remove = document.createElement("button");
      remove.type = "button";
      remove.className = buttonClass("danger");
      remove.textContent = "Delete";
      remove.addEventListener("click", async () => {
        const deleted = await fetch(`/v1/users/${encodeURIComponent(person.user_id)}`, {
          method: "DELETE",
          headers: authHeaders(),
        });
        const payload = await deleted.json();
        if (!deleted.ok) show(payload.detail ?? "Delete failed");
        await refresh(!deleted.ok);
      });
      item.append(name, remove);
      list.append(item);
    }
  }

  document.querySelector("#save-token")?.addEventListener("click", () => {
    saveToken(tokenInput?.value ?? "");
    refresh().catch((error: unknown) => show(error instanceof Error ? error.message : "Could not reach the API"));
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const id = userId?.value.trim() ?? "";
    const response = await fetch(`/v1/users/enroll?user_id=${encodeURIComponent(id)}`, {
      method: "POST",
      headers: authHeaders(),
    });
    const body = await response.json();
    show(response.ok ? body.message : (body.detail ?? "Enrolment failed"), response.ok);
    if (response.ok && userId) userId.value = "";
    await refresh(true);
  });

  refresh().catch((error: unknown) => show(error instanceof Error ? error.message : "The API is unreachable."));
</script>
