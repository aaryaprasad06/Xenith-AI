---
import Base from "../layouts/Base.astro";
---

<Base title="Preview — Face-ID" current="preview">
  <h1>Preview</h1>
  <p class="lead">
    Left infrared from the D435. Authenticate runs the depth liveness check.
    A live face is still denied until identity matching exists, so the door stays locked.
    A flat photo or phone screen should come back rejected.
  </p>
  <section class="panel">
    <img class="stream" src="/v1/preview/stream" alt="Live infrared preview" />
    <div class="row">
      <button id="auth" type="button">Authenticate</button>
      <span id="health"></span>
    </div>
    <p id="result" class="result"></p>
  </section>
</Base>

<script>
  const health = document.querySelector("#health");
  const result = document.querySelector("#result");
  const auth = document.querySelector("#auth");

  async function refreshHealth(): Promise<void> {
    const response = await fetch("/health");
    const body = await response.json();
    if (health) health.textContent = `camera: ${body.camera}`;
  }

  auth?.addEventListener("click", async () => {
    if (!result) return;
    result.textContent = "asking…";
    const response = await fetch("/v1/auth", { method: "POST" });
    const body = await response.json();
    result.textContent = `${body.decision}\n${body.status}\n${body.reason}`;
  });

  refreshHealth().catch((error: unknown) => {
    if (health) health.textContent = error instanceof Error ? error.message : "API unreachable";
  });
</script>
